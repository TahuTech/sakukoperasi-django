# --- Django ---
# true hanya untuk development lokal (runserver + auto-reload).
# Production: false (gunicorn + static via whitenoise) dan DJANGO_SECRET_KEY wajib diisi.
DJANGO_DEBUG=true
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Isi jika diakses lewat domain/HTTPS, contoh: https://koperasi.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set false HANYA jika production diakses lewat HTTP biasa (tanpa HTTPS), agar login admin berfungsi.
DJANGO_SECURE_COOKIES=true

# --- Database ---
DB_NAME=sakukoperasi_db
DB_USER=postgres
DB_PASSWORD=ganti-password-db
DB_HOST=db
DB_PORT=5432

# --- Admin awal (dibuat otomatis saat container start jika belum ada) ---
# Kosongkan password untuk melewati auto-seed; password lemah akan ditolak.
AUTO_SEED_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@sakukoperasi.local
